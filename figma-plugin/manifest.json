{
  "name": "FigBlend",
  "id": "figblend",
  "api": "1.0.0",
  "main": "dist/code.js",
  "ui": "src/ui.html",
  "editorType": [
    "figma"
  ],
  "documentAccess": "dynamic-page",
  "networkAccess": {
    "allowedDomains": [
      "http://localhost:8787",
      "http://localhost:8788",
      "http://localhost:8789",
      "http://localhost:8790",
      "http://localhost:8791",
      "http://localhost:8792",
      "http://localhost:8793",
      "http://localhost:8794",
      "https://api.github.com"
    ],
    "devAllowedDomains": [
      "http://localhost:8787",
      "http://localhost:8788",
      "http://localhost:8789",
      "http://localhost:8790",
      "http://localhost:8791",
      "http://localhost:8792",
      "http://localhost:8793",
      "http://localhost:8794"
    ],
    "reasoning": "Sends exports to the FigBlend Blender add-on listening on your own machine (localhost), so you do not have to import files by hand. Also asks api.github.com at most once a day whether a newer FigBlend release exists. No design data is sent anywhere but your own computer."
  }
}
